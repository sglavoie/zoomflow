# Spread-import with ...@zoomflow (the browser supplies zoomflow.d2).
# Neutral D2 palettes keep the library legible in both light and dark exports.
vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
  }
}
classes: {
  zf-in: {
    shape: oval
    style: {stroke-width: 2; stroke-dash: 3}
  }
  zf-out: {
    shape: oval
    style: {stroke-width: 2; stroke-dash: 3}
  }
  zf-initial: {
    shape: circle
    label: ""
    width: 20
    height: 20
    style: {fill: "#64748b"; stroke: "#64748b"}
  }
  zf-final: {
    shape: circle
    label: ""
    width: 24
    height: 24
    style: {fill: "#64748b"; stroke: "#64748b"; double-border: true}
  }
  zf-state: {
    shape: rectangle
    style: {border-radius: 8; stroke-width: 2}
  }
  # Mind maps: a central topic, main branches and deeper topics.
  # Add one zf-accent-N (1-6) per branch, to its topics and lines alike.
  zf-topic: {
    style: {border-radius: 999; stroke-width: 3; font-size: 20; bold: true}
  }
  zf-branch: {
    style: {border-radius: 999; stroke-width: 2; bold: true}
  }
  zf-leaf: {
    style: {border-radius: 999; stroke-width: 1; bold: false}
  }
  zf-accent-1: {style.stroke: "#e5484d"}
  zf-accent-2: {style.stroke: "#e38a1f"}
  zf-accent-3: {style.stroke: "#30a46c"}
  zf-accent-4: {style.stroke: "#0090ff"}
  zf-accent-5: {style.stroke: "#8e4ec6"}
  zf-accent-6: {style.stroke: "#d6409f"}
}
