# Spread-import with ...@zoomflow (the browser supplies zoomflow.d2).
# Neutral D2 palettes keep the library legible in both light and dark exports.
vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
  }
}
classes: {
  zf-in: {
    shape: oval
    style: {stroke-width: 2; stroke-dash: 3}
  }
  zf-out: {
    shape: oval
    style: {stroke-width: 2; stroke-dash: 3}
  }
  zf-initial: {
    shape: circle
    label: ""
    width: 20
    height: 20
    style: {fill: "#64748b"; stroke: "#64748b"}
  }
  zf-final: {
    shape: circle
    label: ""
    width: 24
    height: 24
    style: {fill: "#64748b"; stroke: "#64748b"; double-border: true}
  }
  zf-state: {
    shape: rectangle
    style: {border-radius: 8; stroke-width: 2}
  }
  # Flows: the flow builder's actions, decisions and start or end points.
  zf-step: {shape: rectangle}
  zf-decision: {shape: diamond}
  zf-terminal: {shape: oval}
  # Roles for any diagram. Combine them with others, as in [zf-state; zf-muted].
  zf-emphasis: {
    style: {stroke-width: 3; bold: true}
  }
  zf-muted: {style.opacity: 0.5}
  zf-external: {style.stroke-dash: 4}
  zf-warning: {
    style: {stroke: "#e38a1f"; stroke-width: 2}
  }
  zf-note: {
    shape: page
    style: {italic: true}
  }
  # Mind maps: a central topic, main branches and deeper topics.
  # Add one zf-accent-N (1-6) per branch, to its topics and lines alike.
  zf-topic: {
    style: {border-radius: 999; stroke-width: 3; font-size: 20; bold: true}
  }
  zf-branch: {
    style: {border-radius: 999; stroke-width: 2; bold: true}
  }
  zf-leaf: {
    style: {border-radius: 999; stroke-width: 1; bold: false}
  }
  zf-accent-1: {style.stroke: "#e5484d"}
  zf-accent-2: {style.stroke: "#e38a1f"}
  zf-accent-3: {style.stroke: "#30a46c"}
  zf-accent-4: {style.stroke: "#0090ff"}
  zf-accent-5: {style.stroke: "#8e4ec6"}
  zf-accent-6: {style.stroke: "#d6409f"}
  # Looks the builders add after the other classes. The fixed fill and text colours
  # read the same in light and dark themes.
  zf-filled: {
    style: {fill: "#e2e8f0"; font-color: "#1e293b"}
  }
  zf-compact: {style.font-size: 13}
}
