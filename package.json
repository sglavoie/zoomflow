{
  "name": "zoomflow",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p packages/core && tsc -p packages/viewer && tsc -p packages/cli && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json && tsc -p .",
    "lint": "biome check .",
    "dev": "pnpm --filter @zoomflow/web dev",
    "build": "pnpm --filter @zoomflow/web build",
    "zoomflow": "node packages/cli/bin/zoomflow.mjs",
    "release": "node scripts/release.ts",
    "release:build": "node scripts/package-release.ts",
    "release:smoke": "node scripts/smoke-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@zoomflow/cli": "workspace:*",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
