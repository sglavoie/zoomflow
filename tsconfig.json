{
  // Tests, root configs and spikes. Package sources have their own tsconfig.json;
  // `pnpm typecheck` checks every project.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"] },
  "include": [
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    // Vite's `?raw` and `?url` imports in the web sources the tests load.
    "apps/web/src/vite-env.d.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "spike/*.mjs"
  ]
}
