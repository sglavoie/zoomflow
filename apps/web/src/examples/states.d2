# State transitions with explicit input/output contracts.
# Enable "Check boundary ports": this example has one matched input and output.
# Port identifiers match the neighbouring shapes on the parent board.
...@zoomflow
direction: right
submitted: Submitted {class: [zf-step; zf-filled]}
review: Review {class: [zf-step; zf-filled]; link: layers.review}
published: Published {class: [zf-terminal; zf-filled]}
submitted -> review -> published
layers: {
  review: {
    direction: right
    submitted: Entry {class: [zf-in; zf-filled]}
    published: Exit {class: [zf-out; zf-filled]}
    start: {class: zf-initial}
    checking: Checking {class: [zf-state; zf-filled]}
    revision: Needs revision {class: [zf-state; zf-filled]}
    approved: Approved {class: [zf-state; zf-filled]}
    finish: {class: zf-final}
    submitted -> checking
    start -> checking
    checking -> revision: Revise
    revision -> checking: Resubmit
    checking -> approved: Accept
    approved -> finish
    approved -> published
    back: Overview {class: [zf-step; zf-filled]; link: _; near: top-left; width: 88; height: 32; style.font-size: 16}
  }
}
