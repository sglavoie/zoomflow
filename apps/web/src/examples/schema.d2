# SQL tables: types, constraints and connections to individual columns.
# The ELK layout engine used by Zoomflow routes links to the referenced row.
# Reference: https://d2lang.com/tour/sql-tables/
...@zoomflow
direction: down
# Keep column names (B2) and constraints (AA2) above AA contrast when fitted.
vars: {
  d2-config: {
    theme-overrides: {B2: "#52677f"; AA2: "#4163db"}
    dark-theme-overrides.B2: "#a8bdd5"
  }
}
customers: Customers {
  shape: sql_table
  class: zf-filled
  id: uuid {constraint: primary_key}
  email: text {constraint: unique}
}
orders: Orders {
  shape: sql_table
  class: zf-filled
  id: uuid {constraint: primary_key}
  customer_id: uuid {constraint: foreign_key}
  total: decimal
}
items: Order items {
  shape: sql_table
  class: zf-filled
  id: uuid {constraint: primary_key}
  order_id: uuid {constraint: foreign_key}
  sku: text
}
customers.id -> orders.customer_id: Places {class: zf-to-many}
orders.id -> items.order_id: Contains {class: zf-to-many}
