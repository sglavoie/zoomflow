...@zoomflow
direction: right
Browse -> Checkout -> Receipt
Browse.class: [zf-step; zf-filled]
Checkout: {class: [zf-step; zf-filled]; link: layers.checkout}
Receipt.class: zf-terminal
layers: {
  checkout: {
    direction: right
    Cart -> Charge -> Confirm
    Cart.class: [zf-step; zf-filled]
    Charge: {class: [zf-step; zf-filled]; link: layers.charge}
    Confirm.class: zf-terminal
    layers: {
      charge: {
        # Created with the Zoomflow flow builder.
        ...@zoomflow
        direction: right

        step_1: "Authorize" {class: [zf-step; zf-filled]}
        step_2: "Capture" {class: [zf-step; zf-filled]}
        step_3: "Receipt" {class: [zf-terminal; zf-filled]}

        step_1 -> step_2: ""
        step_2 -> step_3: ""
      }
    }
  }
}
