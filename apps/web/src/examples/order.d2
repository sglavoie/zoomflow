# Created with the Zoomflow flow builder.
...@zoomflow
direction: right

Browse: "Browse" {class: [zf-step; zf-filled]}
Checkout: "Checkout" {class: [zf-step; zf-filled]}
Receipt: "Receipt" {class: [zf-terminal; zf-filled]}

Browse -> Checkout: ""
Checkout -> Receipt: ""

# Boards that open from shapes on this board.
Checkout.link: layers."checkout"
layers."checkout": {
  # Created with the Zoomflow flow builder.
  ...@zoomflow
  direction: right

  Cart: "Cart" {class: [zf-step; zf-filled]}
  Charge: "Charge" {class: [zf-step; zf-filled]}
  Confirm: "Confirm" {class: [zf-terminal; zf-filled]}

  Cart -> Charge: ""
  Charge -> Confirm: ""

  # Boards that open from shapes on this board.
  Charge.link: layers."charge"
  layers."charge": {
    # Created with the Zoomflow flow builder.
    ...@zoomflow
    direction: right

    step_1: "Authorize" {class: [zf-step; zf-filled]}
    step_2: "Capture" {class: [zf-step; zf-filled]}
    step_3: "Receipt" {class: [zf-terminal; zf-filled]}

    step_1 -> step_2: ""
    step_2 -> step_3: ""
  }
}
