# Containers, dotted paths, parent scope, variables and reusable styles.
# The bundled stdlib supplies offline icons; the local class reuses a variable.
# Reference: https://d2lang.com/tour/containers/
...@zoomflow
direction: down
vars: {
  product: Bookshop
  accent: "#64748b"
}
classes: {
  service: {
    style.stroke: ${accent}
  }
}
reader: Storefront {class: [zf-step; service; zf-filled]}
platform: ${product} {
  class: zf-lane
  api: Catalogue API {class: [zf-step; service; zf-filled]; link: layers.delivery}
  cache: Cache {class: [zf-step; zf-filled]}
  database: Books {class: [zf-step; zf-filled]}
  api <-> cache: Read / refresh
  api -> database: Query
  _.reader -> api: HTTPS
}
layers.delivery: {
  direction: right
  queue: Event queue {class: [zf-step; zf-stack; zf-filled]}
  worker: Email worker {class: [zf-step; service; zf-filled]}
  monitor: Metrics {class: [zf-step; zf-icon-server; zf-filled]}
  queue -> worker: Deliver {class: zf-async}
  monitor -- worker: Observes {class: zf-optional}
  back: Overview {class: [zf-step; zf-filled]; link: _; near: top-left}
}
