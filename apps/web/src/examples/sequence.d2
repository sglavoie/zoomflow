# Sequence diagrams preserve message order from top to bottom.
# Declare participants before using them inside a group.
# Reference: https://d2lang.com/tour/sequence-diagrams/
...@zoomflow
shape: sequence_diagram
customer: Customer {class: [zf-step; zf-icon-user; zf-filled]}
store: Storefront {class: [zf-step; zf-filled]}
payments: Payments {class: [zf-step; zf-filled]}
warehouse: Warehouse {class: [zf-step; zf-filled]}
customer -> store: Place order
payment: Authorize payment {
  class: zf-group
  store -> payments: Create authorization
  payments -> store: Authorized {class: zf-optional}
}
store -> warehouse: Reserve items
store -> customer: Order confirmation {class: zf-optional}
